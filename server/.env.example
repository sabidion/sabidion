# Copia este archivo a .env en el VPS y rellénalo. El archivo .env NO se sube a git.

PORT=3000
HOST=127.0.0.1

# Contraseña del panel de administración (/admin). Usa una larga y única.
ADMIN_PASSWORD=
# Cadena aleatoria larga para firmar la sesión del panel (por ejemplo: openssl rand -hex 32)
SESSION_SECRET=
# Poner a 1 cuando el panel se sirva por HTTPS (cookie Secure)
COOKIE_SECURE=0

# Origen de la web que puede llamar a la API (la URL de GitHub Pages o tu dominio)
CORS_ORIGIN=https://sabidion.github.io
# URL pública de esta API, usada en los enlaces de pago
PUBLIC_URL=http://localhost:3000

# Token compartido con el plugin de Velocity/Leaf (por ejemplo: openssl rand -hex 32)
PLUGIN_TOKEN=

# Proveedor de pago: "simulado" (pruebas) o "tebex" (fase 2)
PAGO_PROVEEDOR=simulado
# Moneda de la tienda
MONEDA=USD

# Fase 2 (Tebex Checkout API). No las rellenes hasta tener la aprobación.
TEBEX_PROJECT_ID=
TEBEX_PRIVATE_KEY=
